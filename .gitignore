# Python build cache
__pycache__/
*.pyc

# Build artifacts / packaged copies
*.zip

# Node / Netlify function dependencies
node_modules/
.netlify/

# Local secrets — the API key lives here when running the site locally.
# NEVER commit this file.
.env
.env.*
!.env.example

# Submissions waiting to be checked. This repository is public, and the file holds
# the names and email addresses of people who used the forms, so it must not be
# committed. It is rebuilt from Netlify by get-submissions.bat whenever it is needed.
draft/Submissions.xlsx

# Local editor / assistant settings, including a preview server config
.claude/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Office lock files, written next to a document while it is open in Word or Excel
~$*

# Generated by `netlify dev` (edge functions runtime)
deno.lock
