# Copy this file to ".env" and fill in a key, to run the AI answers locally with
#   netlify dev
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Mac)
#
# ".env" is git-ignored, so your key stays on your machine. Never put a key in
# this example file, or in any .html or .js file — those are public.

# --- Default: Google Gemini (free tier, no credit card) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional ---
# LLM_PROVIDER=gemini          # "gemini" (default) or "claude"
# GEMINI_MODEL=gemini-2.5-flash

# Only needed if you switch LLM_PROVIDER to "claude". Paid, per-token:
# https://console.anthropic.com -> API keys (set a spend limit while you're there)
# ANTHROPIC_API_KEY=
